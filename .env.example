# =====================================================================
# MINIMUM TO BOOT
# ---------------------------------------------------------------------
# Every setting in config.py has a default, so nothing raises at import.
# The app starts without any of this — features fail closed instead, and
# `run_preflight()` reports exactly what is missing. These three are the
# ones with no graceful degradation:
#
#   MARKETER_DATABASE_URL     get_pool() raises RuntimeError without it
#   MARKETER_OPENAI_API_KEY   the only preflight ERROR; scripting, TTS
#                             and hero images all route through it
#   Clerk (JWKS + issuer)     every authenticated route rejects without it
#
# Everything else below is a warning at worst. Run this to see the live
# report for your environment:
#   python -c "import sys;sys.path.insert(0,'src');\
#   from marketer.services.preflight import run_preflight;\
#   print(run_preflight().to_dict())"
# =====================================================================

# NOTE: these keys are read with the MARKETER_ prefix (config.py sets
# env_prefix="MARKETER_"). Unprefixed names are NOT picked up.

# OpenAI (images, TTS, Whisper, Agents SDK). The one hard requirement.
MARKETER_OPENAI_API_KEY=

# xAI Grok Imagine — the DEFAULT video backend. Without it, video niches
# have no animation provider unless they select fal instead.
MARKETER_XAI_API_KEY=

# Social publishing (Ayrshare).
MARKETER_AYRSHARE_API_KEY=

# Modal (set via `modal token set`, not env)

# Supabase Postgres (use the pooler connection string for the runtime app).
MARKETER_DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Clerk JWT verification for the FastAPI backend.
MARKETER_CLERK_JWKS_URL=https://<your-clerk-frontend>.clerk.accounts.dev/.well-known/jwks.json
MARKETER_CLERK_ISSUER=https://<your-clerk-frontend>.clerk.accounts.dev

# Pipeline defaults (per-niche values override these — kept for ops scripts).
MARKETER_ASPECT=9:16

# Maximum number of scene-asset tasks (image + animation) that run in parallel.
# Decrease to reduce burst spend and provider rate-limit pressure.
MARKETER_SCENE_FANOUT_LIMIT=4

# Concurrency caps for the nightly batch scheduler.
# Global: total Modal containers for run_pipeline across the whole deployment.
MARKETER_PIPELINE_GLOBAL_CONCURRENCY=20
# Per-user: max simultaneous jobs for one user (advisory lock via Postgres).
MARKETER_PIPELINE_PER_USER_CONCURRENCY=3
# Per-niche: max simultaneous jobs for one niche; 1 serializes to prevent
# character-sheet write races.
MARKETER_PIPELINE_PER_NICHE_CONCURRENCY=1

# CORS allow-list for the FastAPI backend. Comma-separated origins (no
# trailing slash). Leave empty in local dev to fall back to "*" with
# credentials disabled.
MARKETER_WEB_ORIGIN=https://your-app.vercel.app

# Sentry error reporting. Leave DSN empty to disable Sentry entirely.
# MARKETER_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
MARKETER_SENTRY_DSN=
MARKETER_SENTRY_ENVIRONMENT=production
MARKETER_SENTRY_TRACES_SAMPLE_RATE=0.0

# Ayrshare webhook HMAC secret. Must match the secret configured in your
# Ayrshare dashboard under Settings → Webhooks. Leave empty to disable
# webhook ingestion (the endpoint will return 503).
MARKETER_AYRSHARE_WEBHOOK_SECRET=

# Optional Redis URL for distributed rate-limit storage (slowapi).
# When unset, rate limits use in-process memory (safe for single-instance).
# MARKETER_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# OpenTelemetry tracing. Leave MARKETER_OTEL_EXPORTER_OTLP_ENDPOINT empty
# to disable OTEL entirely (no spans, no exporter, no overhead).
#
# Honeycomb:
#   MARKETER_OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io/
#   MARKETER_OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<your-api-key>
#
# Axiom:
#   MARKETER_OTEL_EXPORTER_OTLP_ENDPOINT=https://api.axiom.co/
#   MARKETER_OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>,x-axiom-dataset=marketer
#
# Datadog:
#   MARKETER_OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.datadoghq.com/
#   MARKETER_OTEL_EXPORTER_OTLP_HEADERS=DD-API-KEY=<key>
#
# Grafana Tempo (self-hosted):
#   MARKETER_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/
#   MARKETER_OTEL_EXPORTER_OTLP_HEADERS=
#
MARKETER_OTEL_EXPORTER_OTLP_ENDPOINT=
MARKETER_OTEL_SERVICE_NAME=marketer
MARKETER_OTEL_EXPORTER_OTLP_HEADERS=
MARKETER_OTEL_TRACES_SAMPLE_RATE=1.0

# --- Hosted product (Route A) ------------------------------------------
# Prepaid-credits billing. Leave disabled for self-hosted deployments —
# the pipeline then runs on your keys with only your spend caps.
MARKETER_BILLING_ENABLED=false
# Debit multiplier over raw provider cost (1.5 = cost + 50%).
MARKETER_BILLING_MARGIN=1.5
MARKETER_STRIPE_SECRET_KEY=
# From the Stripe dashboard webhook endpoint (checkout.session.completed
# -> https://<api>/api/v1/billing/webhook).
MARKETER_STRIPE_WEBHOOK_SECRET=
# Public origin for checkout redirects and email links.
MARKETER_APP_URL=https://your-app.vercel.app

# Transactional email (Resend). Empty = notifications silently skipped.
MARKETER_RESEND_API_KEY=
MARKETER_EMAIL_FROM="marketer <notifications@yourdomain.com>"

# --- Web (Vercel project env, not backend) -------------------------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...   (required at build time)
# CLERK_SECRET_KEY=sk_live_...                    (required by middleware)
# NEXT_PUBLIC_API_BASE_URL=https://<your-api>     (FastAPI origin the proxy forwards to)

# --- Context.dev brand intelligence + web extraction ------------------------
# One key powers brand lookup, page scraping (markdown + rendered HTML),
# styleguide extraction, and structured product extraction. Required by the
# ad creative studio and the SEO auditor; both fail closed (409) without it.
MARKETER_CONTEXT_DEV_API_KEY=

# --- Ad creative studio (domain -> on-brand ad images) ----------------------
# Off by default. Needs MARKETER_CONTEXT_DEV_API_KEY + MARKETER_OPENAI_API_KEY.
MARKETER_AD_CREATIVE_ENABLED=false

# --- SEO auditor (AI answer-engine readability) -----------------------------
# Off by default. Needs MARKETER_CONTEXT_DEV_API_KEY.
MARKETER_SEO_AUDIT_ENABLED=false

# --- UGC studio (script + reference images -> spokesperson video) -----------
# Off by default. Renders submit to MUAPI; completions arrive by webhook when
# the URL + secret are set, otherwise by reconciliation polling only.
MARKETER_UGC_ENABLED=false
MARKETER_MUAPI_API_KEY=
# Public origin MUAPI posts completion webhooks back to, e.g. https://<api>
MARKETER_MUAPI_WEBHOOK_URL=
# Shared secret required on every webhook delivery. Empty = endpoint refuses all.
MARKETER_MUAPI_WEBHOOK_SECRET=

# --- Seedance 2.5 video provider --------------------------------------------
# Served by the same MuAPI gateway; unset falls back to MARKETER_MUAPI_API_KEY.
# Both empty = the provider is unavailable and says so loudly.
MARKETER_SEEDANCE_API_KEY=
# JSON {model_id|model_id@resolution: usd_per_second} correcting pinned prices
# without a deploy, e.g. '{"seedance-2.5-omni-reference@720p": "0.18"}'
MARKETER_SEEDANCE_PRICE_OVERRIDES=

# --- Stock footage for motion-graphics b-roll (Pexels) -----------------------
# Empty = the stock strategy finds nothing and every shot falls back to a
# generated keyframe, rather than failing the render.
MARKETER_PEXELS_API_KEY=

# --- Article pipeline (written content / SEO) -------------------------------
# Exa API key for SERP research. Optional: unset degrades research to model
# knowledge instead of failing runs. https://exa.ai
MARKETER_EXA_API_KEY=
# Long-form writer model (defaults to the agent model).
MARKETER_ARTICLE_WRITER_MODEL=gpt-5.4-mini
# Generate an editorial hero image per article (gpt-image-1).
MARKETER_ARTICLE_HERO_IMAGE=true


# =====================================================================
# PREVIOUSLY UNDOCUMENTED
# ---------------------------------------------------------------------
# config.py defines 98 settings; this file described 41 of them. The rest
# were mostly tuning knobs with sound defaults, but these carry real
# credentials and were invisible. Defaults shown are what config.py uses.
# =====================================================================

# --- Video / audio providers ------------------------------------------
# fal.ai — the alternative video backend. A niche set to `fal` fails at
# submit time without this. Preflight warns.
MARKETER_FAL_API_KEY=
# JSON {model: usd_per_second} to correct pinned prices without a deploy.
MARKETER_FAL_PRICE_OVERRIDES=

# ElevenLabs — voiceover AND generative background music. A niche set to
# the ElevenLabs voice provider fails without it; music degrades silently.
MARKETER_ELEVENLABS_API_KEY=
MARKETER_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
MARKETER_ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenRouter — alternative script models. Unset falls back to the agent
# model rather than failing.
MARKETER_OPENROUTER_API_KEY=

# Pixabay — stock imagery (companion to the Pexels key above).
MARKETER_PIXABAY_API_KEY=

# --- Object storage ----------------------------------------------------
# Off by default: media then lives on the Modal volume only. Enabling it
# without the four fields below makes every upload/presign raise
# ObjectStorageDisabled — preflight catches that combination.
MARKETER_WASABI_ENABLED=false
MARKETER_WASABI_BUCKET=
MARKETER_WASABI_ACCESS_KEY_ID=
MARKETER_WASABI_SECRET_ACCESS_KEY=
MARKETER_WASABI_ENDPOINT_URL=https://s3.us-east-1.wasabisys.com
MARKETER_WASABI_REGION=us-east-1
MARKETER_WASABI_PRESIGN_EXPIRY_SEC=3600

# --- Paid ads (Google / Meta via Composio) -----------------------------
# Off by default. Spend above the threshold needs human approval.
MARKETER_ADS_ENABLED=false
MARKETER_ADS_APPROVAL_THRESHOLD_USD=50.0
MARKETER_COMPOSIO_API_KEY=
MARKETER_COMPOSIO_GOOGLEADS_AUTH_CONFIG_ID=
MARKETER_COMPOSIO_METAADS_AUTH_CONFIG_ID=

# --- Durable event orchestration (Inngest) -----------------------------
MARKETER_INNGEST_SIGNING_KEY=
MARKETER_INNGEST_EVENT_KEY=
MARKETER_INNGEST_DEV=false

# --- x402 agent-native top-ups -----------------------------------------
# Off by default. Lets an agent pay for its own credits on-chain.
MARKETER_X402_ENABLED=false
MARKETER_X402_NETWORK=
MARKETER_X402_PAY_TO=
MARKETER_X402_FACILITATOR_URL=
MARKETER_X402_MIN_TOPUP_USD=
MARKETER_X402_MAX_TOPUP_USD=

# --- Models and tuning -------------------------------------------------
MARKETER_AGENT_MODEL=gpt-5.4-mini
MARKETER_IDEATION_CANDIDATES=3
MARKETER_CAMPAIGN_EST_COST_PER_PIECE_USD=2.50
# Per-provider parallelism ceilings. Lower them to cut burst spend and
# rate-limit pressure.
MARKETER_FAL_MAX_CONCURRENCY=16
MARKETER_ELEVENLABS_MAX_CONCURRENCY=8
MARKETER_OPENAI_IMAGES_MAX_CONCURRENCY=24
MARKETER_OPENAI_TTS_MAX_CONCURRENCY=16
MARKETER_GROK_MAX_CONCURRENCY=8
# JSON {provider: limit} overriding any of the above without a deploy.
MARKETER_PROVIDER_MAX_CONCURRENCY_OVERRIDES=
# Turn preflight warnings into a hard startup failure.
MARKETER_PREFLIGHT_STRICT=false

# --- Paths (containers) -------------------------------------------------
MARKETER_ARTIFACTS_DIR=/artifacts
MARKETER_ASSETS_DIR=/assets
# Hops to trust in X-Forwarded-For when rate limiting.
MARKETER_TRUSTED_PROXY_HOPS=1

# --- Remaining settings, all with working defaults ---------------------
# Listed so this file covers all 98 of config.py's settings and a reader
# never has to grep the source to find out what exists.

# Optional `aud` claim to enforce on Clerk JWTs. Empty = not checked.
MARKETER_CLERK_AUDIENCE=

# Provider base URLs — override only to point at a proxy or a mock.
MARKETER_CONTEXT_DEV_BASE_URL=
MARKETER_MUAPI_BASE_URL=
MARKETER_SEEDANCE_BASE_URL=
MARKETER_CONTEXT_DEV_TIMEOUT_SEC=

# Ad creative studio shape.
MARKETER_AD_CREATIVE_PLANNER_MODEL=
MARKETER_AD_CREATIVE_COMPANY_COUNT=
MARKETER_AD_CREATIVE_PRODUCT_MIN=
MARKETER_AD_CREATIVE_PRODUCT_MAX=
MARKETER_AD_CREATIVE_FANOUT_LIMIT=

# SEO auditor caching and render wait.
MARKETER_SEO_AUDIT_CACHE_TTL_SEC=
MARKETER_SEO_AUDIT_HTML_WAIT_MS=

# UGC reference-image ceiling.
MARKETER_UGC_MAX_REFERENCE_IMAGES=

# x402 asset identity (only read when MARKETER_X402_ENABLED=true).
MARKETER_X402_ASSET=
MARKETER_X402_ASSET_NAME=
MARKETER_X402_ASSET_VERSION=

# =====================================================================
# NOT read by the backend — listed so this file is a complete map.
# See docs/ENVIRONMENT.md for the full picture.
# ---------------------------------------------------------------------
# SDK / CLI / MCP client (the caller's shell, not the server):
#   MARKETER_API_BASE_URL=https://<your-api>
#   MARKETER_API_TOKEN=mkt_...
#
# Web app (web/.env.local or Vercel):
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY,
#   NEXT_PUBLIC_API_BASE_URL, NEXT_PUBLIC_SITE_URL
#
# Tests / CI:
#   MARKETER_RUN_LIVE_EVALS=1   (spends real money; off by default)
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB  (CI service container)
#
# Modal: `modal token set`, plus five named secrets. NOTE that only
# openai / xai / ayrshare / supabase / clerk are mounted in modal_app.py —
# fal, ElevenLabs, Stripe, MuAPI, Context.dev, Resend, Pexels, Exa,
# Wasabi, Composio and Inngest are read by the backend but have no secret
# wired, so they work locally and silently not in production.
# =====================================================================
