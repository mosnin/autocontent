    "cf-typegen": "wrangler types",
    "dlq:replay": "node scripts/replay-dlq.mjs",
    "typecheck:web": "tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@agent-starter/cloudflare": "file:./vendor/agent-starter/cloudflare",
    "@agent-starter/core": "file:./vendor/agent-starter/core",
    "@agent-starter/evals": "file:./vendor/agent-starter/evals",
    "@agent-starter/flue": "file:./vendor/agent-starter/flue",
    "@agent-starter/integrations": "file:./vendor/agent-starter/integrations",
    "@agent-starter/react": "file:./vendor/agent-starter/react",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@flue/runtime": "2.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "hono": "^4.13.17",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@earendil-works/pi-ai": "1.4.0",
    "@flue/vite": "2.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "promptfoo": "^0.125.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.159.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript-eslint": "8.72.0",
    "@flue/sdk": "2.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
