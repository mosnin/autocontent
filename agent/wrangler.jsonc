// Generated by create-agent-starter. Bindings are merged from the selected modules.
// Flue adds one Durable Object binding per agent at build time (never declare FLUE_* bindings here).
// Queue, R2 bucket and Vectorize index names are global per Cloudflare account, so they carry the project name.
// Migrations are append-only: when you add an agent or DO later, add a new tag with new_sqlite_classes.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marketer-agents",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "TENANT_CONFIG",
      "id": "REPLACE_WITH_TENANT_CONFIG_KV_ID"
    },
    {
      "binding": "AGENT_CACHE",
      "id": "REPLACE_WITH_AGENT_CACHE_KV_ID"
    },
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_OAUTH_KV_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WORKSPACE_BUCKET",
      "bucket_name": "marketer-agents-workspaces"
    }
  ],
  "vectorize": [
    {
      "binding": "AGENT_MEMORY_INDEX",
      "index_name": "marketer-agents-memory"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "SERVICE_NAME": "marketer-agents",
    "CODE_VERSION": "1.0.0",
    "PUBLIC_BASE_URL": "http://localhost:5173",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:5173",
    "AGENT_MODEL": "",
    "AGENT_FALLBACK_MODELS": "",
    "FIRST_LINE_MODEL": "",
    "AI_SEARCH_INSTANCE": "",
    "PRIMARY_SAAS_API_URL": "",
    "PRIMARY_SAAS_WEBHOOK_URL": "",
    "CF_ACCOUNT_ID": "",
    "AI_GATEWAY_ID": "",
    "DO_JURISDICTION": "",
    "DO_LOCATION_HINT": "",
    "OPS_ALERT_EMAIL": "",
    "AI_GATEWAY_CACHE_TTL": "",
    "OTLP_TRACES_ENDPOINT": "",
    "EVAL_TENANTS": "",
    "EVAL_ALLOW_LIVE": "",
    "EVENTS_QUEUE_NAME": "marketer-agents-events",
    "EVENTS_DLQ_NAME": "marketer-agents-events-dlq",
    "SHADOW_SAMPLE_RATE": "0",
    "SHADOW_MODEL": "",
    "AGENT_BUS_NAME": "marketer-agents-bus",
    "AGENT_BUS_DLQ_NAME": "marketer-agents-bus-dlq",
    "PERSISTENT_EGRESS_ALLOW": "",
    // The autopilot's own fetches can never reach Supermemory: only src/marketer/recall/client.ts talks to it.
    "PERSISTENT_EGRESS_DENY": "api.supermemory.ai",
    "PERSISTENT_REVIEW_MODEL": "",
    // Execution-rails kill switch (not a secret): "" = off, "publish", "spend", "publish,spend" or "all".
    "MARKETER_RAILS_KILL_SWITCH": "",
    "OPENROUTER_DECISIONS_URL": "",
    "DECISION_MODEL": "",
    "DECISION_MODES": "",
    // Recall (docs/memory/supermemory.md): "" = https://api.supermemory.ai. Secrets: SUPERMEMORY_API_KEY, MEMORY_NAMESPACE_SECRET.
    "SUPERMEMORY_BASE_URL": "",
    // Braintrust (docs/observability/braintrust.md): off unless the BRAINTRUST_API_KEY secret and the project id are set.
    // API URL "" = https://api.braintrust.dev (EU: https://api-eu.braintrust.dev). Content: "redacted" (default) or "metadata".
    "BRAINTRUST_PROJECT_ID": "",
    "BRAINTRUST_API_URL": "",
    "BRAINTRUST_CONTENT": "redacted"
  },
  "queues": {
    "producers": [
      {
        "binding": "EVENTS_QUEUE",
        "queue": "marketer-agents-events"
      },
      {
        "binding": "AGENT_BUS",
        "queue": "marketer-agents-bus"
      }
    ],
    "consumers": [
      {
        "queue": "marketer-agents-events",
        "max_batch_size": 10,
        "max_batch_timeout": 10,
        "max_retries": 5,
        "dead_letter_queue": "marketer-agents-events-dlq"
      },
      {
        "queue": "marketer-agents-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3
      },
      {
        "queue": "marketer-agents-bus",
        "max_batch_size": 25,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "marketer-agents-bus-dlq"
      },
      {
        "queue": "marketer-agents-bus-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RUN_REGISTRY",
        "class_name": "AgentRunRegistry"
      },
      {
        "name": "GROUP_CHAT_ROOM",
        "class_name": "SwarmRoom"
      },
      {
        "name": "PERSISTENT_CONTROL",
        "class_name": "PersistentAgentControl"
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "17 6 * * *"
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FlueAssistantAgent",
        "FlueCopilotAgent",
        "FlueBackgroundWorkerAgent",
        "FlueOrchestratorAgent",
        "FlueAnalystAgentAgent",
        "FlueWriterAgentAgent",
        "FlueSecurityAuditorAgentAgent",
        "FluePersistentAgentAgent",
        "AgentRunRegistry",
        "SwarmRoom",
        "PersistentAgentControl"
      ]
    },
    {
      // Marketer's departments (agent-starter-scaffold: new identities get NEW classes in a NEW tag; v1 is never edited).
      "tag": "v2",
      "new_sqlite_classes": [
        "FlueStrategistAgent",
        "FlueContentProducerAgent",
        "FlueSeoEditorAgent",
        "FlueMediaBuyerAgent",
        "FlueDistributionManagerAgent"
      ]
    }
  ]
}
