__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env
.env.local
dist/
build/

# Local artifacts
outputs/
artifacts/
*.mp4
*.wav
*.mp3
*.png
*.jpg
# …but images under web/public are shipped UI, not generated media. Without
# this the hero renders an empty tunnel everywhere except a dev machine that
# happened to run the installer.
!web/public/**/*.png
!web/public/**/*.jpg

# Framer static export fetched by `originkit add opsra`. 9MB of minified
# runtime and hashed fonts — a separate deployable site, not source.
web/opsra/

# Tooling
.ruff_cache/
.mypy_cache/
.pytest_cache/
.DS_Store

# Claude Code harness sub-agent worktrees (not project code)
.claude/
.coverage

# Playwright scratch from verification runs
web/.pwtmp/
