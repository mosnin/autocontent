NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Modal-hosted FastAPI backend (marketer::api).
NEXT_PUBLIC_API_BASE_URL=https://<workspace>--marketer-api.modal.run

# Canonical origin, used by app/robots.ts and app/sitemap.ts to emit
# absolute URLs. Unset means the sitemap points at the wrong host.
NEXT_PUBLIC_SITE_URL=https://marketer.sh
