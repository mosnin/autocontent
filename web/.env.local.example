NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Middleware also hardcodes these so a missing Vercel env cannot 404
# logged-out /dashboard (Clerk protect-rewrite → /_not-found). Set them
# anyway so client-side Clerk and the Account Portal agree.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Modal-hosted FastAPI backend (marketer::api).
NEXT_PUBLIC_API_BASE_URL=https://<workspace>--marketer-api.modal.run

# Canonical origin, used by app/robots.ts and app/sitemap.ts to emit
# absolute URLs. Unset means the sitemap points at the wrong host.
NEXT_PUBLIC_SITE_URL=https://marketer.sh
