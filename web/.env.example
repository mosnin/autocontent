# Web app environment. Copy to .env.local for development.
# How the pieces fit: docs/auth/web.md. Never commit real values.

# --- Better Auth (sign-in, workspaces, roles) --------------------------------
# 32+ random bytes: `openssl rand -base64 32`. Signs cookies and encrypts the
# backend JWT signing key stored in auth.jwks. Changing it signs everyone out
# and invalidates the stored key (clear auth.jwks after a rotation).
BETTER_AUTH_SECRET=
# The public web origin, https in production. Also the backend JWT issuer
# (the backend's MARKETER_AUTH_ISSUER must equal it).
BETTER_AUTH_URL=http://localhost:3000
# Postgres with the `auth` schema (db/migrations/0030_auth.sql). Use a pooled
# connection on Vercel. Falls back to DATABASE_URL.
AUTH_DATABASE_URL=
# Connections per server instance (1-10, default 3).
# AUTH_DB_POOL_MAX=3

# Client address for rate limits and the security log. On Vercel nothing to
# set. Self-hosted: the header your proxy sets, and the proxies' addresses.
# Unset in self-hosted production = no trusted address (one shared bucket).
# AUTH_IP_HEADER=x-forwarded-for
# AUTH_TRUSTED_PROXIES=10.0.0.0/8

# Verification, password reset and invitation email (Resend HTTP API). Without
# a key in development, links print to the server log; in production sending
# fails instead.
RESEND_API_KEY=
EMAIL_FROM="Marketer <no-reply@yourdomain.com>"

# Optional: "Continue with Google" appears only when both are set.
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backend and agent --------------------------------------------------------
# Modal-hosted FastAPI backend (marketer::api).
NEXT_PUBLIC_API_BASE_URL=https://<workspace>--marketer-api.modal.run
# Agent harness (agent/). Optional; without it chat shows an offline state.
# NEXT_PUBLIC_AGENT_ORIGIN=https://<agent-worker>
# SESSION_SIGNING_SECRET=   (must match the Worker's)

# --- Security headers ---------------------------------------------------------
# The strict CSP is report-only until this is "enforce" (build and runtime).
# CSP_MODE=enforce
